# Copy to `.env` for local development. All values have safe defaults.

# Database connection string. Defaults to a local SQLite file.
DATABASE_URL=sqlite:///./zoomclone.db

# Public URL of the deployed frontend — used to build shareable invite links.
FRONTEND_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins (frontend URLs).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seed sample data on first startup.
SEED_ON_STARTUP=true
